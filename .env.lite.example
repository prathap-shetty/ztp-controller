POSTGRES_PASSWORD=replace-with-random-database-password
ZTP_ADMIN_PASSWORD=ReplaceThisLabPassword123
ZTP_INVENTORY_PROVIDER=local-yaml
ZTP_LOCAL_INVENTORY_DIR=./inventory
# auto: local YAML/InfraHub use catalog; Lite NetBox uses its config context.
# Set catalog to retain explicit compatibility/source-release profiles with NetBox.
ZTP_CATALOG_SOURCE=auto
# A directory uses lite.json inside it; an existing explicit JSON path also works.
ZTP_CATALOG_FILE=./catalog
ZTP_IMAGE_DIR=./images
ZTP_BIND_ADDRESS=10.10.10.1
# Second management VLAN; requires compose.lite.multi-vlan.yaml.
# ZTP_BIND_ADDRESS_2=10.50.0.1
ZTP_HTTP_PORT=80
ZTP_API_PORT=8001
ZTP_BOOTSTRAP_DIR=./deploy/bootstrap
ZTP_KEA_CONFIG=./deploy/lite/kea.json
# For NetBox instead: set provider=netbox and fill these two values.
ZTP_NETBOX_URL=https://netbox.example.invalid
# main or the eight-character NetBox branch schema ID (not its display name)
ZTP_NETBOX_BRANCH=main
ZTP_NETBOX_TOKEN=
ZTP_NETBOX_PLATFORM_SLUG=cisco_nxos

# ZTP Lite: accept unlisted source releases; NX-OS can still reject the install.
ZTP_SKIP_SOURCE_VALIDATION=true

# Keep a newer installed numeric NX-OS release; apply configuration only.
ZTP_ALLOW_NEWER_VERSION=true

# Generate with: openssl rand -hex 32. Blank disables the dashboard.
ZTP_DASHBOARD_TOKEN=

# Optional InfraHub inventory (set ZTP_INVENTORY_PROVIDER=infrahub).
ZTP_INFRAHUB_URL=https://infrahub.example.invalid
ZTP_INFRAHUB_TOKEN=
ZTP_INFRAHUB_BRANCH=main
ZTP_INFRAHUB_PLATFORM=cisco_nxos
ZTP_INFRAHUB_VERIFY_SSL=true
ZTP_INFRAHUB_ALLOW_HTTP=false

# Opt-in IOS XR configuration-only support (Python 3 ZTP helper required)
ZTP_XR_ENABLED=false
ZTP_XR_PLATFORM_SLUG=cisco_iosxr

# Opt-in IOS XE configuration-only support (Guest Shell Python 3 required)
ZTP_XE_ENABLED=false
ZTP_XE_PLATFORM_SLUG=cisco_iosxe

# Opt-in Arista EOS configuration-only support (Python 3 on the switch required)
ZTP_EOS_ENABLED=false
ZTP_EOS_PLATFORM_SLUG=arista_eos
# Opt-in post-provisioning check by ztp-worker: ping, SSH login as admin with
# ZTP_ADMIN_PASSWORD, chassis identity and rendered configuration. Pins the first
# SSH host key seen per attempt.
ZTP_LITE_VERIFICATION=false
