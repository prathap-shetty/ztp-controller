{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [
        "ens3"
      ]
    },
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv"
    },
    "valid-lifetime": 3600,
    "renew-timer": 900,
    "rebind-timer": 1800,
    "client-classes": [
      {
        "name": "ztp-eos",
        "test": "substring(option[60].text,0,7) == 'Arista;'",
        "option-data": [
          {
            "name": "boot-file-name",
            "data": "http://10.10.10.1/bootstrap/eos.py",
            "always-send": true
          }
        ],
        "boot-file-name": "http://10.10.10.1/bootstrap/eos.py"
      },
      {
        "name": "ztp-iosxe",
        "test": "option[60].text == 'ciscopnp'",
        "option-data": [
          {
            "name": "boot-file-name",
            "data": "http://10.10.10.1/bootstrap/iosxe.py",
            "always-send": true
          }
        ],
        "boot-file-name": "http://10.10.10.1/bootstrap/iosxe.py"
      },
      {
        "name": "ztp-iosxr",
        "test": "option[77].hex == 'exr-config' or option[77].hex == 'xr-config'",
        "option-data": [
          {
            "name": "boot-file-name",
            "data": "http://10.10.10.1/bootstrap/iosxr.py",
            "always-send": true
          }
        ],
        "boot-file-name": "http://10.10.10.1/bootstrap/iosxr.py"
      },
      {
        "name": "ztp-nxos",
        "test": "substring(option[77].hex,0,11) == 0x0a436973636f2d504f4150",
        "option-data": [
          {
            "name": "tftp-server-name",
            "data": "http://10.10.10.1",
            "always-send": true
          },
          {
            "name": "boot-file-name",
            "data": "bootstrap/nxos.py",
            "always-send": true
          }
        ]
      }
    ],
    "subnet4": [
      {
        "id": 1,
        "subnet": "10.10.10.0/24",
        "interface": "ens3",
        "pools": [
          {
            "pool": "10.10.10.10 - 10.10.10.149"
          }
        ],
        "option-data": [
          {
            "name": "routers",
            "data": "10.10.10.1",
            "always-send": true
          },
          {
            "name": "domain-name-servers",
            "data": "8.8.8.8",
            "always-send": true
          }
        ],
        "match-client-id": false
      }
    ],
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [
          {
            "output": "stdout"
          }
        ],
        "severity": "INFO"
      }
    ]
  }
}
