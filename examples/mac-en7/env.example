# Copy to .env.poc.mac at the repository root. DHCP runs natively on en7.
POSTGRES_PASSWORD=replace-with-random-database-password
POC_ADMIN_PASSWORD=ReplaceThisLabPassword123
ZTP_INVENTORY_PROVIDER=local-yaml
ZTP_LOCAL_INVENTORY_DIR=./inventory
ZTP_CATALOG_FILE=./catalog/poc.json
ZTP_IMAGE_DIR=./images
ZTP_BIND_ADDRESS=10.10.10.1
ZTP_HTTP_PORT=80
ZTP_API_PORT=8001
ZTP_BOOTSTRAP_DIR=./deploy/bootstrap
# For NetBox instead: set provider=netbox and fill these two values.
ZTP_NETBOX_URL=https://192.168.0.210
ZTP_NETBOX_TOKEN=
ZTP_NETBOX_PLATFORM_SLUG=cisco_nxos

# PoC: accept unlisted source releases; NX-OS can still reject the install.
ZTP_SKIP_SOURCE_VALIDATION=true

# Keep a newer installed numeric NX-OS release; apply configuration only.
ZTP_ALLOW_NEWER_VERSION=true

# Generate with: openssl rand -hex 32. Blank disables the dashboard.
ZTP_DASHBOARD_TOKEN=

# Optional InfraHub inventory (set ZTP_INVENTORY_PROVIDER=infrahub).
ZTP_INFRAHUB_URL=http://host.docker.internal:8000
ZTP_INFRAHUB_TOKEN=
ZTP_INFRAHUB_BRANCH=main
ZTP_INFRAHUB_PLATFORM=cisco_nxos
ZTP_INFRAHUB_VERIFY_SSL=true
ZTP_INFRAHUB_ALLOW_HTTP=false
