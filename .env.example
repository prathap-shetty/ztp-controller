# Local development only. Generate a unique URL-safe password before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
ZTP_NETBOX_URL=https://netbox.example.invalid
# Disable only for an explicitly trusted lab with a self-signed NetBox certificate.
ZTP_NETBOX_VERIFY_SSL=true
ZTP_NETBOX_TOKEN_PATH=./secrets/netbox_token
ZTP_NETBOX_AUTH_SCHEME=Token
ZTP_NETBOX_PLATFORM_SLUG=nxos
ZTP_ALLOW_HTTP_NETBOX=false
ZTP_CATALOG_FILE=./catalog/profiles.json
ZTP_API_PORT=8000

# M2a: opt in after editing the example catalog, network and SSH files.
ZTP_EXECUTION_MODE=planning-only
ZTP_ALLOW_UNQUALIFIED_LAB=false
ZTP_SSH_USERNAME=ztp
ZTP_SSH_PUBLIC_DIR=./secrets/ssh-public
ZTP_SSH_VALIDATION_DIR=./secrets/ssh-validation
ZTP_BOOTSTRAP_DIR=./deploy/bootstrap
ZTP_TLS_DIR=./deploy/tls
ZTP_KEA_CONFIG=./deploy/kea/kea-dhcp4.json
ZTP_NGINX_CONFIG=./deploy/nginx/nginx.conf
ZTP_BIND_ADDRESS=127.0.0.1
ZTP_HTTP_PORT=8080
ZTP_HTTPS_PORT=8443
ZTP_VALIDATION_DELAY_SECONDS=90
ZTP_VALIDATION_DEADLINE_SECONDS=1800
ZTP_VALIDATION_RETRY_SECONDS=30
ZTP_VALIDATION_MAX_ATTEMPTS=30

# Large images live on the host, mounted read-only into the API.
ZTP_IMAGE_DIR=./images
ZTP_UPGRADE_VALIDATION_DELAY_SECONDS=1800
ZTP_UPGRADE_DEADLINE_SECONDS=7200

# Use compose.local.yaml to remove the NetBox secret requirement.
ZTP_INVENTORY_PROVIDER=netbox
ZTP_LOCAL_INVENTORY_DIR=./inventory
