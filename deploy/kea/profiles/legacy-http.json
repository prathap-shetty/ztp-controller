{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [
        "eth1"
      ]
    },
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv"
    },
    "valid-lifetime": 3600,
    "renew-timer": 900,
    "rebind-timer": 1800,
    "subnet4": [
      {
        "id": 1,
        "subnet": "192.0.2.0/24",
        "interface": "eth1",
        "pools": [
          {
            "pool": "192.0.2.100 - 192.0.2.199"
          }
        ],
        "option-data": [
          {
            "name": "routers",
            "data": "192.0.2.1"
          },
          {
            "name": "domain-name-servers",
            "data": "192.0.2.1"
          },
          {
            "name": "tftp-server-name",
            "data": "http://192.0.2.2",
            "always-send": true
          },
          {
            "name": "boot-file-name",
            "data": "bootstrap/poap.py",
            "always-send": true
          }
        ]
      }
    ],
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [
          {
            "output": "stdout"
          }
        ],
        "severity": "INFO"
      }
    ]
  }
}
