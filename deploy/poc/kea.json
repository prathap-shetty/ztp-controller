{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [
        "ens3"
      ]
    },
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv"
    },
    "valid-lifetime": 3600,
    "renew-timer": 900,
    "rebind-timer": 1800,
    "subnet4": [
      {
        "id": 1,
        "subnet": "10.10.10.0/24",
        "interface": "ens3",
        "pools": [
          {
            "pool": "10.10.10.10 - 10.10.10.149"
          }
        ],
        "option-data": [
          {
            "name": "routers",
            "data": "10.10.10.1",
            "always-send": true
          },
          {
            "name": "domain-name-servers",
            "data": "8.8.8.8",
            "always-send": true
          },
          {
            "name": "tftp-server-name",
            "data": "http://10.10.10.1",
            "always-send": true
          },
          {
            "name": "boot-file-name",
            "data": "bootstrap/poap.py",
            "always-send": true
          }
        ]
      }
    ],
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [
          {
            "output": "stdout"
          }
        ],
        "severity": "INFO"
      }
    ]
  }
}
